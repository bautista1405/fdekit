{
  "name": "@fdekit/catalog",
  "version": "0.5.3",
  "description": "Provider, connector, and recipe manifests: the shared source of truth for FDEKit scaffolding, docs, and deployment surfaces",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
